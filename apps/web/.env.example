# Clerk — development instance key locally, never production.
VITE_CLERK_PUBLISHABLE_KEY=""

VITE_API_URL="http://localhost:3000"

# Stripe publishable key. Test key on beta, live key only in production.
VITE_STRIPE_PUBLISHABLE_KEY=""

# Web push subscription needs the PUBLIC VAPID key in the browser.
# Same keypair as the API's VAPID_PUBLIC_KEY — generate once, use both places.
VITE_VAPID_PUBLIC_KEY=""
