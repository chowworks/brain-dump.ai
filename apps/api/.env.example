# ─── Required for local dev ────────────────────────────────────────────────────

# Railway Postgres. Copy the connection string from the database service's
# Variables tab (DATABASE_URL or DATABASE_PUBLIC_URL for connecting from your
# laptop).
#
# Point this at the DEV database, never at beta. `prisma migrate dev` offers to
# DROP AND RECREATE the database when it detects schema drift — that is normal
# local workflow and catastrophic against a shared environment.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway"
WEB_ORIGIN="http://localhost:5173"
PORT=3000

# Clerk — use the DEVELOPMENT instance keys locally, never production.
CLERK_SECRET_KEY=""

# Anthropic. The extraction pass is pinned to Haiku on cost grounds
# (~$0.003/transform vs ~$0.020 on Opus for the same structured extraction).
ANTHROPIC_API_KEY=""

# ─── Required before anything ships ───────────────────────────────────────────

# Resend — reminders by email, a FREE-tier channel.
# Verify the sending domain on the PRIMARY domain (mind-dump.com), not on
# brain-dump.ai, which only redirects. DKIM/SPF records go in Spaceship.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="reminders@mind-dump.com"

# Web push — the other FREE-tier reminder channel. Self-hosted over VAPID, so
# there is no vendor and no per-message cost.
# Generate with:  npx web-push generate-vapid-keys
# The private key is a secret: put it in the secrets store, never in the repo.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@mind-dump.com"

# Stripe — the PRO subscription. Use TEST keys on beta so a beta checkout can
# never charge a real card.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# ─── SMS / iMessage capture — vendor NOT yet decided (see #3) ─────────────────
#
# These names assume Telnyx and are placeholders. The choice is open between
# Telnyx, Sendblue and Linq, and #3 has to answer whether one shared number can
# route to many users before any of this is wired.
#
# Cost note: Telnyx is ~$0.008 per message part all-in, NOT the $0.004 headline
# rate — US carriers add a surcharge per part on top of it.
#
# Gated on 10DLC registration (#1) for any traffic touching carrier SMS.
TELNYX_API_KEY=""
TELNYX_MESSAGING_PROFILE_ID=""
